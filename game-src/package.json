{
  "name": "last-outpost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:economy",
    "build:economy": "esbuild src/economy-entry.ts --bundle --format=iife --minify --target=es2019 --outfile=../game/economy.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
